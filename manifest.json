{
  "manifest_version": 3,
  "name": "Custom New Tab",
  "version": "1.0",
  "description": "Opens a custom page in every new tab.",
  "author": "Your Name",
  "permissions": [],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "web_accessible_resources": [
  {
    "resources": ["coloration.js", "module-script.js", "config.js", "icons.js"],
    "matches": ["<all_urls>"]
  }
]

}
